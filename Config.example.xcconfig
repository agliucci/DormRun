// Copy to Config.xcconfig (gitignored) and fill in values.
// Xcode → Project → Info → Configurations → based on Config.xcconfig
//
// Never put sk_ (Stripe secret) or service_role keys here — app-facing only.
//
// Live / App Store money:
//   STRIPE_PUBLISHABLE_KEY = pk_live_…
//   supabase secrets set STRIPE_SECRET_KEY=sk_live_… STRIPE_WEBHOOK_SECRET=whsec_…
//   Re-run Connect bank link after switching to live (test accounts don’t carry over).

SUPABASE_URL = https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = your-anon-key
STRIPE_PUBLISHABLE_KEY = pk_test_your_key
STRIPE_MERCHANT_ID = merchant.edu.umass.eats
